{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user identity and role metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserWallet": {
      "title": "UserWallet",
      "description": "Per-user daily free quota and paid character credit balance.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "paidCredits": {
          "type": "integer"
        },
        "dailyUsedChars": {
          "type": "integer"
        },
        "dailyDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dailyLimit": {
          "type": "integer"
        },
        "totalCharsUsed": {
          "type": "integer"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "paidCredits",
        "dailyUsedChars",
        "dailyDate",
        "dailyLimit",
        "totalCharsUsed",
        "plan",
        "updatedAt"
      ]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Immutable accounting ledger record for character usage and credit top-ups.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["tts_usage", "credit_purchase", "admin_grant"]
        },
        "chars": {
          "type": "integer"
        },
        "creditsDelta": {
          "type": "integer"
        },
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "type", "chars", "creditsDelta", "model", "note", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Explicit administrator membership record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document keyed by Firebase Auth UID."
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/UserWallet" },
      "description": "User quota and credit accounting wallet keyed by Firebase Auth UID."
    },
    "/ledger/{entryId}": {
      "schema": { "$ref": "#/entities/LedgerEntry" },
      "description": "Immutable credit top-up and speech usage accounting entries."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin access registry."
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidWalletId(id) {
      return id is string && id.size() > 0 && id.size() <= 254 && id.matches('^[a-zA-Z0-9_\\-.@+]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPrimaryAdmin() {
      return isSignedIn()
        && request.auth.uid == 'T2t9j7YD2JaTsichCnZkFlzxr6w1'
        && request.auth.token.email == 'moutther580@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isPrimaryAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isWalletOwner(walletId) {
      return isSignedIn() && (
        request.auth.uid == walletId ||
        (request.auth.token.email_verified == true && request.auth.token.email == walletId)
      );
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 120
        && data.role in ['user', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWallet(data, walletId) {
      return data.keys().hasAll(['uid', 'email', 'paidCredits', 'dailyUsedChars', 'dailyDate', 'dailyLimit', 'totalCharsUsed', 'plan', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'paidCredits', 'dailyUsedChars', 'dailyDate', 'dailyLimit', 'totalCharsUsed', 'plan', 'updatedAt'])
        && data.uid is string && isValidWalletId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (data.uid == walletId || data.email == walletId)
        && data.paidCredits is int && data.paidCredits >= 0 && data.paidCredits <= 100000000
        && data.dailyUsedChars is int && data.dailyUsedChars >= 0 && data.dailyUsedChars <= 1000000
        && data.dailyDate is string && data.dailyDate.size() == 10 && data.dailyDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.dailyLimit is int && data.dailyLimit >= 0 && data.dailyLimit <= 1000000
        && data.totalCharsUsed is int && data.totalCharsUsed >= 0 && data.totalCharsUsed <= 1000000000
        && data.plan in ['free', 'pro']
        && data.updatedAt is timestamp;
    }

    function isValidLedgerEntry(data, entryId) {
      return data.keys().hasAll(['id', 'uid', 'type', 'chars', 'creditsDelta', 'model', 'note', 'createdAt'])
        && data.keys().hasOnly(['id', 'uid', 'type', 'chars', 'creditsDelta', 'model', 'note', 'createdAt'])
        && data.id is string && data.id == entryId && isValidId(data.id)
        && data.uid is string && isValidWalletId(data.uid)
        && data.type in ['tts_usage', 'credit_purchase', 'admin_grant']
        && data.chars is int && data.chars >= 0 && data.chars <= 10000000
        && data.creditsDelta is int && data.creditsDelta >= -10000000 && data.creditsDelta <= 100000000
        && data.model is string && data.model.size() <= 80
        && data.note is string && data.note.size() <= 240
        && data.createdAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.createdAt is timestamp;
    }

    function isValidContactMessage(data, messageId) {
      return data.keys().hasAll(['id', 'name', 'email', 'subject', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'email', 'subject', 'message', 'status', 'createdAt'])
        && data.id is string && data.id == messageId && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 120
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 2000
        && data.status in ['unread', 'read']
        && data.createdAt is timestamp;
    }

    function isValidReferral(data, userId) {
      return data.keys().hasAll(['uid', 'referrerUid', 'bonusGranted', 'createdAt'])
        && data.keys().hasOnly(['uid', 'referrerUid', 'bonusGranted', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.referrerUid is string && isValidId(data.referrerUid) && data.referrerUid != userId
        && data.bonusGranted is bool
        && data.createdAt is timestamp;
    }

    function isValidServerConfig(data, configId) {
      return data.keys().hasAll(['id', 'geminiApiKey', 'dailyFreeCharLimit', 'globalDailyFreeChars', 'maintenanceMode', 'siteNotice', 'allowPdfStudio', 'allowPodcastStudio', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['id', 'geminiApiKey', 'dailyFreeCharLimit', 'globalDailyFreeChars', 'maintenanceMode', 'siteNotice', 'allowPdfStudio', 'allowPodcastStudio', 'updatedBy', 'updatedAt'])
        && data.id is string && data.id == configId && isValidId(data.id)
        && data.geminiApiKey is string && data.geminiApiKey.size() <= 256
        && data.dailyFreeCharLimit is int && data.dailyFreeCharLimit >= 0 && data.dailyFreeCharLimit <= 1000000
        && data.globalDailyFreeChars is int && data.globalDailyFreeChars >= 0 && data.globalDailyFreeChars <= 100000000
        && data.maintenanceMode is bool
        && data.siteNotice is string && data.siteNotice.size() <= 400
        && data.allowPdfStudio is bool
        && data.allowPodcastStudio is bool
        && data.updatedBy is string && data.updatedBy.size() >= 3 && data.updatedBy.size() <= 254
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerified() && (isOwner(userId) || isPrimaryAdmin());
      allow list: if isPrimaryAdmin();
      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().role == 'user'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])) ||
          (isPrimaryAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt']))
        );
      allow delete: if isPrimaryAdmin() && isValidId(userId);
    }

    match /wallets/{walletId} {
      allow get: if isValidWalletId(walletId) && isVerified() && (isWalletOwner(walletId) || isPrimaryAdmin());
      allow list: if isPrimaryAdmin();
      allow create: if isValidWalletId(walletId)
        && isValidWallet(incoming(), walletId)
        && incoming().updatedAt == request.time
        && (
          isPrimaryAdmin() ||
          (
            isVerified()
            && walletId == request.auth.uid
            && incoming().uid == request.auth.uid
            && incoming().email == request.auth.token.email
            && incoming().paidCredits == 0
            && incoming().dailyUsedChars == 0
            && incoming().dailyLimit == 3000
            && incoming().totalCharsUsed == 0
            && incoming().plan == 'free'
          )
        );
      allow update: if isValidWalletId(walletId)
        && isPrimaryAdmin()
        && isValidWallet(incoming(), walletId)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['paidCredits', 'dailyUsedChars', 'dailyDate', 'dailyLimit', 'plan', 'updatedAt']);
      allow delete: if isPrimaryAdmin() && isValidWalletId(walletId);
    }

    match /ledger/{entryId} {
      allow get: if isValidId(entryId) && isVerified() && (
        existing().uid == request.auth.uid ||
        (request.auth.token.email_verified == true && existing().uid == request.auth.token.email) ||
        isPrimaryAdmin()
      );
      allow list: if isPrimaryAdmin() || (isVerified() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(entryId)
        && isPrimaryAdmin()
        && isValidLedgerEntry(incoming(), entryId)
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/wallets/$(incoming().uid));
      allow update: if isPrimaryAdmin()
        && isValidId(entryId)
        && isValidLedgerEntry(incoming(), entryId);
      allow delete: if isPrimaryAdmin() && isValidId(entryId);
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && isVerified() && (isOwner(userId) || isPrimaryAdmin());
      allow list: if isPrimaryAdmin();
      allow create: if isValidId(userId)
        && isPrimaryAdmin()
        && isValidAdminRecord(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isPrimaryAdmin() && isValidId(userId) && userId != request.auth.uid;
    }

    match /contactMessages/{messageId} {
      allow get: if isValidId(messageId) && isPrimaryAdmin();
      allow list: if isPrimaryAdmin();
      allow create: if isValidId(messageId)
        && isValidContactMessage(incoming(), messageId)
        && incoming().status == 'unread'
        && incoming().createdAt == request.time;
      allow update: if isValidId(messageId)
        && isPrimaryAdmin()
        && isValidContactMessage(incoming(), messageId)
        && incoming().id == existing().id
        && incoming().name == existing().name
        && incoming().email == existing().email
        && incoming().subject == existing().subject
        && incoming().message == existing().message
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(messageId) && isPrimaryAdmin();
    }

    match /referrals/{userId} {
      allow get: if isValidId(userId) && isVerified() && (isOwner(userId) || existing().referrerUid == request.auth.uid || isPrimaryAdmin());
      allow list: if isPrimaryAdmin() || (isVerified() && resource.data.referrerUid == request.auth.uid);
      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidReferral(incoming(), userId)
        && exists(/databases/$(database)/documents/users/$(incoming().referrerUid))
        && incoming().bonusGranted == false
        && incoming().createdAt == request.time;
      allow update: if isValidId(userId)
        && isPrimaryAdmin()
        && isValidReferral(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().referrerUid == existing().referrerUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['bonusGranted']);
      allow delete: if isValidId(userId) && isPrimaryAdmin();
    }

    match /serverConfig/{configId} {
      allow get: if isValidId(configId) && isPrimaryAdmin();
      allow list: if isPrimaryAdmin();
      allow create: if isValidId(configId)
        && isPrimaryAdmin()
        && isValidServerConfig(incoming(), configId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(configId)
        && isPrimaryAdmin()
        && isValidServerConfig(incoming(), configId)
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(configId) && isPrimaryAdmin();
    }

    // Server-only accounting collections managed exclusively via Firebase Admin / Service Account REST
    match /systemCounters/{counterId} {
      allow read, write: if false;
    }

    match /referralStats/{userId} {
      allow read, write: if false;
    }
  }
}
